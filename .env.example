# Offer.ai environment configuration
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Public (bundled into the browser) ---
# Local Supabase stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# --- Server / worker only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=<service role key>
DATABASE_URL=postgresql://supabase_admin:postgres@127.0.0.1:5432/postgres

# --- AI (server / worker only) ---
# AI_PROVIDER=deepseek | fake | opencode
# Use opencode provider with DeepSeek model via OpenAI-compatible API
AI_PROVIDER=fake
AI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=<deepseek api key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENCODE_API_KEY=<opencode api key — or reuse DEEPSEEK_API_KEY>
OPENCODE_BASE_URL=https://api.deepseek.com
