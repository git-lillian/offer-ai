{
  "name": "offer-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @offer-ai/web dev",
    "worker:dev": "pnpm --filter @offer-ai/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0 && pnpm --filter @offer-ai/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "tsx packages/database/scripts/migrate.ts",
    "db:seed": "tsx packages/database/scripts/seed.ts",
    "db:test": "vitest run --config supabase/tests/vitest.config.ts",
    "db:reset": "tsx packages/database/scripts/migrate.ts --reset",
    "test:e2e": "playwright test --config tests/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}